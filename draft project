.opt.good{background:var(--good-bg);border-color:var(--good);color:var(--good);box-shadow:none}
.opt.bad{background:var(--bad-bg);border-color:var(--bad);color:var(--bad);box-shadow:none}
.fb{margin-top:18px;min-height:8px;position:sticky;bottom:max(12px,env(safe-area-inset-bottom,0px));z-index:5}
