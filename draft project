.streak{display:inline-block;margin-left:8px;font-family:var(--display);background:var(--sun);color:#13233F;border-radius:999px;padding:0 .6rem}
@media (prefers-reduced-motion:no-preference){
  .mascot.cheer{animation:jump .6s ease-out 2}
