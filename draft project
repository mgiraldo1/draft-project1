  const ok=done&&q.o[v.picked]===q.a;
  const prog=v.qs.map((_,k)=>`<i class="${k<v.i||(k===v.i&&done)?'on':k===v.i?'now':''}"></i>`).join('');
  const opts=q.o.map((o,k)=>{let c='opt',m='';if(done){if(o===q.a){c+=' good';m='✓'}else if(k===v.picked){c+=' bad';m='✗'}}
    return `<button class="${c}" data-act="ans" data-i="${k}" ${done?'disabled':''}><span>${esc(o)}</span><span aria-hidden="true">${m}</span></button>`}).join('');
  const last=v.i===total-1;
  const praise=['¡Muy bien!','¡Excelente!','¡Perfecto!','¡Genial!'][v.i%4];
  const fb=done?`<div class="fbbox ${ok?'ok':'no'}" data-focus><p><strong>${ok?'Correct!':'The answer is “'+esc(q.a)+'”'}</strong><span>${esc(q.n)}</span></p>
  <div class="row">${hasTTS&&q.sp?`<button class="btn alt small" data-act="say" data-say="${esc(q.sp)}">🔊 Hear it</button>`:''}<button class="btn" data-act="nxt" data-focus>${last?(mode==='quiz'?'See my results':'Finish'):'Next →'}</button></div></div>`:'';
  const txt=isTxt(q.pic)||q.pic==='🔢';
  return `<section class="card" style="--tc:${t.color}">${coachHTML(v)}<div class="prog" role="img" aria-label="Question ${v.i+1} of ${total}">${prog}</div>
  <span class="chip">${t.pic} ${esc(t.es)}</span>
  <div class="qhead"><div class="tile ${isTxt(q.pic)?'txt':''}">${q.pic}</div><h2>${esc(q.q)}</h2></div>
  <div class="opts">${opts}</div><div class="fb" aria-live="polite">${fb}</div></section>`}

function vQuiz(){return `<h2 class="back">Starter quiz</h2>`+qCard(view,'quiz')}

function vResult(){
  const L=level(S.score),C=2*Math.PI*52,off=C*(1-S.score/10);
  const chips=[...new Set(QUIZ.map(q=>q.t))].map(id=>{const t=topic(id),bad=S.missed.includes(id);
    return `<span class="chip" style="--tc:${t.color}">${bad?'✗':'✓'} ${esc(t.es)}</span>`}).join('');
  const next=S.missed.length?`<div><h3>Let’s practice these first</h3><div class="chips">${S.missed.map(id=>{const t=topic(id);
    return `<button class="btn small" data-act="open" data-id="${id}">${t.pic} ${esc(t.es)}</button>`}).join('')}</div></div>`
    :`<div><h3>Perfect score!</h3><p>Pick any topic and collect all the stars.</p></div>`;
  return `<section class="card">${coachHTML({mood:S.score>=7?'cheer':'happy',say:S.score>=7?'¡Increíble'+nm()+'! You know lots of Spanish!':S.score>=4?'¡Muy bien'+nm()+'! You already know some Spanish!':'¡Bienvenido'+nm()+'! We’ll learn together. Everybody starts somewhere!'},96)}<div class="res"><div class="ring"><svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" fill="none" stroke="var(--line)" stroke-width="12"/>
  <circle cx="60" cy="60" r="52" fill="none" stroke="var(--sky)" stroke-width="12" stroke-linecap="round" stroke-dasharray="${C.toFixed(1)}" stroke-dashoffset="${off.toFixed(1)}"/></svg>
  <div class="t">${S.score}/10</div></div>
  <div style="flex:1 1 260px"><p class="muted">${S.name?esc(S.name)+', your':'Your'} level is</p><h1 data-focus tabindex="-1">${L.pic} ${L.name}</h1>
  <p><span class="badge">${L.en}</span></p><p style="margin-top:10px">${L.msg}</p></div></div>
  <div class="chips">${chips}</div></section>
  <div class="stack"><section class="card">${next}</section>${S.missed.length?videoCard(null,true):''}
  <div class="row"><button class="btn" data-act="hub">Go to my topics →</button></div></div>`}

function tcard(t){const n=S.stars[t.id]||0,rec=S.quizDone&&S.missed.includes(t.id)&&n<3;
  return `<button class="tcard" data-act="open" data-id="${t.id}" style="--tc:${t.color}">${rec?'<span class="ribbon">Try this first</span>':''}
  <div class="tile" style="--tc:${t.color}">${t.pic}</div><div><h3>${esc(t.es)}</h3><p class="muted">${esc(t.en)}</p>
  <span class="stars" role="img" aria-label="${n} of 3 stars">${starsTxt(n)}</span></div></button>`}

function vHub(){const L=level(S.score);
  return `<section class="card"><div class="hero"><div class="copy"><h1 data-focus tabindex="-1">¡Hola${S.name?', '+esc(S.name):''}!</h1>
  <p>Your level: <span class="badge">${L.pic} ${L.name}</span></p>
  <p class="muted">You got ${S.score}/10 on the starter quiz. Pick a topic and earn 3 stars on each!</p><p class="muted">Stars collected: <strong>${TOPICS.reduce((a,t)=>a+(S.stars[t.id]||0),0)}</strong> of ${TOPICS.length*3}</p></div>
  </div><div style="margin-top:14px">${coachHTML({mood:'happy',say:'Tap me for a fun Spanish tip!'},84)}</div></section>
  ${CATS.map(c=>`<h2 class="cat">${c[1]}</h2><div class="grid">${TOPICS.filter(t=>t.cat===c[0]).map(tcard).join('')}</div>`).join('')}
  <div class="stack"><div class="row"><button class="btn alt" data-act="retake">↻ Retake the quiz</button></div></div>`}

function vLearn(t){
  const tbl=t.table?`<div class="conj">${t.table.map(r=>`<div class="crow"><div class="pic" aria-hidden="true">${r[3]}</div><div class="pr">${r[0]}</div><div class="v">${r[1]}</div><div class="m">${r[2]}</div></div>`).join('')}</div>
  <h3 style="margin-bottom:12px">Fun ways Spanish uses tener</h3>`:'';
  const cards=t.items.map((it,k)=>`<div class="vcard"><button class="vmain" data-act="flip" aria-expanded="false"><span class="vpic ${isTxt(it.pic)?'txt':''}">${it.pic}</span>
  <span class="es">${esc(it.es)}</span><span class="en">${esc(it.en)}</span><span class="hint">Tap to see English</span></button>
  ${hasTTS?`<div class="vbar"><button class="btn alt small" data-act="say" data-say="${esc(it.es)}" aria-label="Hear ${esc(it.es)}">🔊 Listen</button></div>`:''}</div>`).join('');
  return `${t.note?`<div class="card note">💡 ${t.note}</div>`:''}<p class="muted" style="margin-bottom:16px">Tap a card to see what it means${hasTTS?', and press Listen to hear it':''}.</p>${tbl}<div class="vgrid">${cards}</div>
  <div class="row" style="margin-top:22px"><button class="btn" data-act="tab" data-tab="practice">Ready? Let’s practice →</button></div>`}

function vPracticeIntro(t){const n=S.stars[t.id]||0;
  return `<section class="card"><div class="res"><div style="flex:1 1 260px"><h2>5 quick questions</h2><p style="margin:8px 0">Get them right to win stars. You can play as many times as you like!</p>
  <p class="stars" style="font-size:1.8rem" role="img" aria-label="${n} of 3 stars">${starsTxt(n)}</p></div>${coachHTML({mood:'happy',say:'Ready'+nm()+'? ¡Vamos!'},100)}</div>
  <div class="row" style="margin-top:16px"><button class="btn" data-act="play">Start practice</button></div></section>`}

function vTopic(){const t=topic(view.id),tab=view.tab;
  const tabs=[['learn','Learn'],['practice','Practice'],['watch','Watch']].map(([k,l])=>`<button class="tab" role="tab" aria-selected="${tab===k}" data-act="tab" data-tab="${k}">${l}</button>`).join('');
  const body=tab==='learn'?vLearn(t):tab==='practice'?vPracticeIntro(t):videoCard(t);
  return `<button class="btn alt small back" data-act="hub">← All topics</button>
  <div class="thead" style="--tc:${t.color}"><div class="tile">${t.pic}</div><div><h1 data-focus tabindex="-1">${esc(t.es)}</h1><p class="muted">${esc(t.en)}</p></div></div>
  <div class="tabs" role="tablist">${tabs}</div>${body}`}

function vPlay(){const t=topic(view.id);
  return `<button class="btn alt small back" data-act="stop">← Stop</button>`+qCard(view,'practice')}

function vDone(){const t=topic(view.id),n=view.stars,c=view.correct;
  const msg=n===3?'¡Fantástico! A perfect round.':n===2?'¡Muy bien! Nearly perfect.':n===1?'Good try! Practice makes perfect.':'Keep going. Every try helps you learn!';
  return `<section class="card" style="--tc:${t.color}"><div style="text-align:center;display:grid;gap:12px;justify-items:center"><div style="justify-self:stretch;text-align:left">${coachHTML({mood:n>=2?'cheer':'happy',say:msg},96)}</div>
  <h1 data-focus tabindex="-1">${c}/5 correct</h1><div class="bigstars" role="img" aria-label="${n} of 3 stars">${starsTxt(n)}</div><p><strong>+${c*10} XP</strong></p>
  <div class="row" style="justify-content:center"><button class="btn" data-act="play">Play again</button>
  <button class="btn alt" data-act="open" data-id="${t.id}">Review the cards</button><button class="btn alt" data-act="hub">All topics</button></div></div></section>
  ${n<2?`<div class="stack">${videoCard(t,true)}</div>`:''}`}

function render(keep){
  const v=view.n;
  const main=v==='home'?vHome():v==='quiz'?vQuiz():v==='result'?vResult():v==='hub'?vHub():v==='topic'?vTopic():v==='play'?vPlay():vDone();
  const y=window.scrollY||0;$app.innerHTML=bunting+head()+'<main>'+main+'</main>';if(keep)window.scrollTo(0,y);
}
function go(nv,focus){view=nv;render();if(focus){window.scrollTo(0,0)}const f=$app.querySelector('h1[data-focus]');if(f&&focus)f.focus({preventScroll:true})}

/* ---------- Practice question builder ---------- */
function buildPractice(t){
  if(t.id==='tener')return sample(TENER_QS,5).map(([s,a,tr,pic])=>({t:t.id,pic,q:'Pick the right word: “'+s+'”',o:shuffle([a,...sample(TCONJ.filter(x=>x!==a),3)]),a,sp:s.replace('___',a),n:s.replace('___',a)+' = '+tr}));
  return sample(t.items,5).map((it,k)=>{
    const same=t.items.filter(x=>x!==it&&(x.g||'')===(it.g||'')),pool=same.length>=3?same:t.items.filter(x=>x!==it);
    const n=it.es+' = '+it.en+' '+(isTxt(it.pic)?'':it.pic);
    return k%2===0?{t:t.id,pic:'🤔',q:'What does “'+it.es+'” mean?',o:shuffle([it.en,...sample(pool,3).map(x=>x.en)]),a:it.en,sp:it.es,n}
                  :{t:t.id,pic:it.pic,q:'How do you say “'+it.en+'” in Spanish?',o:shuffle([it.es,...sample(pool,3).map(x=>x.es)]),a:it.es,sp:it.es,n}});
}

/* ---------- Events ---------- */
const act={
  home(){go({n:S.quizDone?'hub':'home'},true)},
  hub(){go({n:'hub'},true)},
  start(){const el=document.getElementById('nm');if(el){S.name=el.value.trim().slice(0,20);save()}
    go({n:'quiz',i:0,qs:QUIZ.map(q=>({...q,o:shuffle(q.o)})),picked:null,correct:0,wrong:[],streak:0,wrongRun:0,mood:'happy',say:'¡Hola'+nm()+'! Take your time. This just helps me pick the best lessons for you.'},true)},
  retake(){act.start()},
  ans(d){if(view.picked!==null)return;view.picked=+d.i;const q=view.qs[view.i];
    const ok=q.o[view.picked]===q.a;if(ok)view.correct++;else if(view.wrong)view.wrong.push(q.t);react(view,ok);
    render(true);const b=$app.querySelector('.fbbox .btn[data-act="nxt"]');if(b)b.focus()},
  nxt(){
    if(view.i<view.qs.length-1){view.i++;view.picked=null;idle(view);render();window.scrollTo(0,0);return}
    if(view.n==='quiz'){S.score=view.correct;S.missed=[...new Set(view.wrong)];S.quizDone=true;
      if(!S.quizXp){S.xp+=view.correct*10;S.quizXp=true}save();go({n:'result'},true)}
    else{const c=view.correct,st=c>=5?3:c>=4?2:c>=3?1:0;S.stars[view.id]=Math.max(S.stars[view.id]||0,st);S.xp+=c*10;save();
      go({n:'done',id:view.id,correct:c,stars:st},true)}},
  open(d){go({n:'topic',id:d.id,tab:'learn'},true)},
  tab(d){view.tab=d.tab;render()},
  play(){const t=topic(view.id);go({n:'play',id:t.id,qs:buildPractice(t),i:0,picked:null,correct:0,streak:0,wrongRun:0,mood:'happy',say:'¡Vamos'+nm()+'! Five questions. You can do it!'},true)},
  stop(){go({n:'topic',id:view.id,tab:'practice'},true)},
  lola(){view.mood='happy';view.say=pick(SAY.tips);const c=$app.querySelector('.coach');
    if(c){const sv=c.querySelector('svg');c.outerHTML=coachHTML(view,sv?+sv.getAttribute('width'):84);const b=$app.querySelector('.lolabtn');if(b)b.focus({preventScroll:true})}},
  say(d){speak(d.say)},
  flip(d,el){const c=el.closest('.vcard');const o=c.classList.toggle('open');el.setAttribute('aria-expanded',o)}
};
$app.addEventListener('click',e=>{const b=e.target.closest('[data-act]');if(!b||b.disabled)return;const f=act[b.dataset.act];if(f)f(b.dataset,b)});
$app.addEventListener('submit',e=>{e.preventDefault();act.start()});
render();
</script>

</body></html>
