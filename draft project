h2.cat{margin:30px 0 14px}
.coach{display:flex;gap:12px;align-items:center;margin-bottom:16px}
.lolabtn{all:unset;box-sizing:border-box;cursor:pointer;flex:none;border-radius:20px;display:block;line-height:0}
.lolabtn:focus-visible{outline:3px solid var(--sky);outline-offset:2px}
.bubble2{position:relative;background:var(--bg);border:2px solid var(--line);border-radius:18px;padding:10px 14px;font-weight:700;min-width:0;flex:1 1 auto}
.bubble2::before{content:"";position:absolute;left:-9px;top:50%;width:14px;height:14px;background:var(--bg);border-left:2px solid var(--line);border-bottom:2px solid var(--line);transform:translateY(-50%) rotate(45deg)}
